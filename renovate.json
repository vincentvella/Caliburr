{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "dependencyDashboard": false,
  "schedule": ["before 9am on monday"],
  "timezone": "America/New_York",
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Auto-merge minor/patch once CI (typecheck) passes.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeStrategy": "squash"
    },
    {
      "description": "Expo/RN core is version-coordinated — group it and never auto-merge; a human reviews SDK moves.",
      "matchPackageNames": [
        "expo",
        "react",
        "react-dom",
        "react-native",
        "react-native-*",
        "expo-*",
        "@expo/**"
      ],
      "groupName": "expo sdk",
      "automerge": false
    },
    {
      "description": "Majors get a standalone PR + a human.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major"]
    }
  ],
  "vulnerabilityAlerts": { "labels": ["security"], "automerge": false }
}
